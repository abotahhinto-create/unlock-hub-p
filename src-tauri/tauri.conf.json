{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UnlockHub",
  "version": "2.5.0",
  "identifier": "com.nashwan.unlockhub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "النظام العربي الشامل - Unlock Hub",
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "bin/*",
      "drivers/*"
    ]
  }
}
